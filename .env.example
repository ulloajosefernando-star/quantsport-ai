# QuantSport AI: copia este archivo a .env y completa SOLO lo que uses.
# Nunca subas .env al repositorio. Este ejemplo no contiene secretos.

# --- Modo de ejecución ---
APP_ENV=local                 # local | cloud | production
DATA_MODE=demo                # demo = liga SINTÉTICA etiquetada; real = solo proveedores configurados
TIMEZONE=America/Mexico_City
LOG_LEVEL=INFO
# DATABASE_URL=sqlite:////ruta/absoluta/quantsport.db   (por defecto: data/quantsport.db)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Protege los endpoints de escritura (importar, sincronizar, umbrales, Telegram).
# Obligatorio fuera de APP_ENV=local. Genera uno con: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Proveedores (vacío = desactivado; nada se contrata automáticamente) ---
# The Odds API, plan Starter gratuito: 500 créditos/mes
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=eu
THE_ODDS_API_MONTHLY_CREDITS=500

# Programador automático (Fase 7). Con el backend encendido sincroniza, registra pronósticos y los liquida.
# Apagado por defecto. Con Liga MX y la configuración de abajo gasta unos 300-450 créditos/mes.
SCHEDULER_ENABLED=false
SCHEDULER_COMPETITIONS=mex_liga_mx
SCHEDULER_ODDS_TIMES=09:00,17:00
SCHEDULER_DAILY_TIME=07:30
SCHEDULER_PREKICKOFF_MINUTES=45
SCHEDULER_CREDIT_RESERVE=50
SCHEDULER_SCORES=true
# football-data.org, plan Free: 10 solicitudes/min, 12 competiciones (sin Liga MX)
FOOTBALL_DATA_ORG_TOKEN=
FOOTBALL_DATA_ORG_PER_MINUTE=10
# API-Football. Plan Free: 100 solicitudes/día y solo temporadas pasadas (la actual requiere plan de pago)
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_PER_MINUTE=10

# NBA: resultados e historial gratis (plan Free de balldontlie.io, 5 consultas/min)
BALLDONTLIE_API_KEY=

# --- Telegram (solo envío de resúmenes en Fase 1; comandos en Fase 6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=    # lista separada por comas; el bot ignora cualquier otro chat
TELEGRAM_MAX_MESSAGES_PER_DAY=20

# --- Presupuesto (tipos de cambio manuales: actualízalos antes de contratar algo) ---
MONTHLY_BUDGET_MXN=500
USD_MXN_RATE=18.42
EUR_MXN_RATE=21.4

# --- Umbrales del motor de valor (opcionales; también editables desde Configuración) ---
# VALUE_MIN_EV=0.03
# VALUE_MIN_EDGE=0.02
# VALUE_MIN_PROB_EV_POSITIVE=0.80
# VALUE_MAX_ODDS_AGE_MINUTES=90
# VALUE_KELLY_FRACTION=0.25
# VALUE_MAX_STAKE_FRACTION=0.02
